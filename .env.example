EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Developer flag: set to "true" to skip auth during local development. NEVER set in production.
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
# Local Expo Go redirect URL for magic link auth (replace with your machine's LAN IP shown in Expo terminal)
# Example: EXPO_PUBLIC_AUTH_REDIRECT_URL=exp://192.168.1.42:8081/--/auth/callback
EXPO_PUBLIC_AUTH_REDIRECT_URL=exp://localhost:8081/--/auth/callback
