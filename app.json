{
  "expo": {
    "name": "Judy",
    "slug": "judy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "judy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8470A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pcdev333.judy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8470A"
      },
      "package": "com.pcdev333.judy"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "deepLinking": {
      "schemes": ["judy", "exp"],
      "prefixes": ["judy://", "exp://"],
      "config": {
        "screens": {
          "(auth)": {
            "screens": {
              "callback": "callback",
              "index": ""
            }
          },
          "(app)": {
            "screens": {
              "index": "index",
              "create": "create",
              "library": "library",
              "planner": "planner",
              "workout": "workout/:id"
            }
          }
        }
      }
    }
  }
}
